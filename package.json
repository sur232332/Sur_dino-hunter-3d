{
  "name": "sur-dino-hunter-3d",
  "version": "1.0.0",
  "description": "Deer & Dino Hunter 2026: GTA VI Ultra Edition (3D WebGL & Electron Game)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.sur.dinohunter3d",
    "productName": "DinoHunter3D",
    "files": [
      "main.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  }
}
